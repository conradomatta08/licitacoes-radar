# Connection string do banco Neon (aba "Connection Details" do painel do Neon).
# Usada tanto pelo pipeline Python (etl/) quanto pelo app Next.js (web/).
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/licitacoes?sslmode=require

# Login do dashboard (web/) - so essas duas variaveis controlam quem
# consegue entrar, ver docs/SETUP.md.
# String aleatoria longa, usada pra assinar a sessao - gere uma so vez e
# nunca reaproveite/compartilhe (ex: `openssl rand -hex 32`).
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
# Uma pessoa por par usuario:senha, separados por virgula.
AUTH_USERS=usuario1:senha1,usuario2:senha2,usuario3:senha3,usuario4:senha4
